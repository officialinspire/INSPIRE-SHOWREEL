{
  "name": "inspire-showreel",
  "version": "0.1.0",
  "private": true,
  "description": "Production pipeline for the INSPIRE studio games showreel: Playwright + Chromium capture, FFmpeg assembly.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "bash scripts/install.sh",
    "check": "node scripts/check-deps.js",
    "verify:urls": "node scripts/verify-urls.js",
    "fetch": "node scripts/fetch-assets.js",
    "validate": "node scripts/validate-assets.js",
    "capture": "node scripts/capture-games.js",
    "capture:all": "node scripts/capture-games.js",
    "capture:sfx": "node scripts/capture-games.js --variant=sfx",
    "capture:hardigan-boys": "node scripts/capture-games.js --only=hardigan-boys",
    "capture:sticks-and-bones": "node scripts/capture-games.js --only=sticks-and-bones",
    "capture:card-parlor": "node scripts/capture-games.js --only=card-parlor",
    "capture:shells-and-feathers": "node scripts/capture-games.js --only=shells-and-feathers",
    "capture:gridlock": "node scripts/capture-games.js --only=gridlock",
    "capture:emoji-elements": "node scripts/capture-games.js --only=emoji-elements",
    "capture:explore": "node scripts/capture/explore.js",
    "capture:report": "node scripts/capture-report.js",
    "build": "node scripts/build-segments.js",
    "render": "node scripts/render.js",
    "render:all": "npm run render:trailer && npm run render:highlights && npm run validate:renders",
    "render:trailer": "node scripts/render-trailer.js",
    "render:trailer:16x9": "node scripts/render-trailer.js --format=16x9",
    "render:trailer:9x16": "node scripts/render-trailer.js --format=9x16",
    "render:trailer:1x1": "node scripts/render-trailer.js --format=1x1",
    "render:highlights": "node scripts/render-highlights.js",
    "render:highlight:hardigan-boys": "node scripts/render-highlights.js --only=hardigan-boys",
    "render:highlight:sticks-and-bones": "node scripts/render-highlights.js --only=sticks-and-bones",
    "render:highlight:card-parlor": "node scripts/render-highlights.js --only=card-parlor",
    "render:highlight:shells-and-feathers": "node scripts/render-highlights.js --only=shells-and-feathers",
    "render:highlight:gridlock": "node scripts/render-highlights.js --only=gridlock",
    "render:highlight:emoji-elements": "node scripts/render-highlights.js --only=emoji-elements",
    "validate:renders": "node scripts/validate-renders.js",
    "produce": "npm run check && npm run verify:urls && npm run fetch && npm run validate && npm run capture:all && npm run build && npm run render",
    "release": "bash scripts/publish-release.sh",
    "clean": "node scripts/clean.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "playwright": "1.63.0"
  }
}
