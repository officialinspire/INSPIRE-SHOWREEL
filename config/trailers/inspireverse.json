  "framing": {
    "comment": "Per game and aspect: 'full' = the capture already matches the frame; 'fit' = whole frame scaled into the canvas over a blurred, darkened fill (nothing cropped); 'crop' = a verified region [x,y,w,h] of the source that holds the action. 9:16 uses the game's own portrait capture wherever the game supports portrait.",
    "16x9": {
      "default": {
        "source": "landscape",
        "mode": "full"
      }
    },
    "9x16": {
      "default": {
        "source": "portrait",
        "mode": "full"
      },
      "hardigan-boys": {
        "source": "landscape",
        "mode": "fit",
        "zoom": 1.0
      }
    },
    "1x1": {
      "default": {
        "source": "landscape",
        "mode": "fit",
        "zoom": 1.0
      },
      "gridlock": {
        "source": "landscape",
        "mode": "crop",
        "rect": [
          420,
          0,
          1080,
          1080
        ],
        "verified": "landscape board spans x 525-1400, y 100-975; the side player cards are partly trimmed"
      },
