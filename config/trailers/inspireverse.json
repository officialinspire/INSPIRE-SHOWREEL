{
  "version": 1,
  "id": "inspireverse-2026",
  "title": "ENTER THE INSPIREVERSE",
  "subtitle": "Official Gameplay Showcase 2026",
  "output": "enter-the-inspireverse-2026",
  "fps": 60,
  "formats": {
    "16x9": {
      "width": 1920,
      "height": 1080,
      "safe": {
        "top": 0.05,
        "bottom": 0.08,
        "left": 0.05,
        "right": 0.05,
        "note": "YouTube/TV: title-safe ~5%, progress bar at the bottom"
      }
    },
    "9x16": {
      "width": 1080,
      "height": 1920,
      "safe": {
        "top": 0.14,
        "bottom": 0.22,
        "left": 0.06,
        "right": 0.16,
        "note": "Reels/TikTok/Shorts: account header at top, caption + buttons at the bottom, action icons on the right"
      }
    },
    "1x1": {
      "width": 1080,
      "height": 1080,
      "safe": {
        "top": 0.06,
        "bottom": 0.1,
        "left": 0.06,
        "right": 0.06,
        "note": "Instagram/X feed"
      }
    }
  },
  "encode": {
    "codec": "libx264",
    "preset": "slow",
    "crf": 17,
    "profile": "high",
    "pixFmt": "yuv420p",
    "audioBitrate": "320k",
    "sampleRate": 48000,
    "level": "4.2",
    "color": {
      "space": "bt709",
      "primaries": "bt709",
      "trc": "bt709",
      "range": "tv"
    }
  },
  "intermediate": {
    "preset": "veryfast",
    "crf": 10
  },
  "brand": {
    "font": "/usr/share/fonts/opentype/inter/InterDisplay-BlackItalic.otf",
    "fontSub": "/usr/share/fonts/opentype/inter/InterDisplay-SemiBold.otf",
    "accent": "0xF4C542",
    "text": "0xFFFFFF",
    "logo": "assets/branding/inspire-logo.png"
  },
  "look": {
    "vignette": 0.3,
    "pushIn": 0.035,
    "sectionDip": 0.16
  },
  "music": {
    "comment": "Emoji Elements - Celestial Battle Theme (OFFICIAL INSPIRE soundtrack, fetched at the pinned commit). Beat grid measured: 136.00 BPM, downbeat 1.334 s, bar 1.7647 s. Starting at bar 8 puts the track's break (bar 26) on the last Shells & Feathers bar and its drop (bar 27) on the montage.",
    "game": "emoji-elements",
    "bpm": 136,
    "firstDownbeatSec": 1.334,
    "startBar": 8,
    "gain": 0.9,
    "fadeInSec": 0.35,
    "fadeOutSec": 3.2
  },
  "audio": {
    "sfxGain": 0.85,
    "edgeFadeSec": 0.03,
    "duck": {
      "threshold": 0.025,
      "ratio": 5,
      "attack": 15,
      "release": 320,
      "makeup": 1
    },
    "loudness": {
      "I": -14,
      "TP": -1.5,
      "LRA": 11
    }
  },
  "intro": {
    "file": "assets/branding/inspiresoftwareintro.mp4",
    "comment": "Original studio intro, first, with its own soundtrack; only scaled/resampled to the delivery format."
  },
  "titleDefaults": {
    "showAtBar": 0.15,
    "holdSec": 2.6
  },
